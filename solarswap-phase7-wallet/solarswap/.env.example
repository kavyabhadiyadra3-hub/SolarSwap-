# Copy this file to ".env" in the project root and fill in your own values.
# Find both of these in your Supabase project: Settings -> API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the "service_role" key here — only the "anon" / "public" key
# belongs in frontend code. Never commit the real .env file to GitHub.
